  "$id": "https://ileaxe.org/schemas/terreiro-v3.schema.json",
  "title": "Entidade canônica nacional de terreiro v3",
  "description": "Contrato experimental do formato nacional comum, nullable e com proveniência por campo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
