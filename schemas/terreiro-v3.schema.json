        "revisao_humana": {
          "enum": [
            "aprovado",
            "pendente",
            "nao_aplicavel",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metodo": {
                "const": "ausente"
              }
            }
          },
          "then": {
            "properties": {
              "tradicao_declarada": {
                "type": "null"
              },
              "nacao_declarada": {
                "type": "null"
              },
              "componentes": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "maxItems": 0
                  }
                ]
              },
              "categoria_analitica": {
                "type": "null"
              },
              "revisao_humana": {
                "const": "nao_aplicavel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metodo": {
                "const": "inferido_nome"
