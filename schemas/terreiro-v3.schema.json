      "allOf": [
        {
          "if": {
            "properties": {
              "status_territorial": {
                "const": "sem_coordenada"
              }
            }
          },
          "then": {
            "properties": {
              "latitude": {
                "type": "null"
              },
              "longitude": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status_territorial": {
                "enum": [
                  "intersecao_ibge",
                  "fora_poligono"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status_territorial": {
                "const": "intersecao_ibge"
              }
            }
          },
          "then": {
            "properties": {
              "uf": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "municipio": {
                "type": "string",
                "minLength": 1
              },
              "codigo_ibge_municipio": {
