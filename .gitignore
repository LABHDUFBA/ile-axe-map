# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# Shared artifacts stay tracked: config.json, design.json, critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/
# impeccable-ignore-end

# caches de re-geocodificacao (contem queries, Place IDs e endereços; nunca públicos)
data/geocode_cache_v43.json
data/places_cache_v44.json
# caches de re-geocodificação da série v4.6+ (guardam query, Place ID e endereço; nunca públicos)
data/geocode_cnpj_cache_v46.json
data/places_cache_v45.json

# Fontes externas com dados pessoais (dirigentes, contatos, endereços completos): só local.
data/atlas_axe/raw_payload.json
data/atlas_axe/casas.json
data/axes_unb/raw_communities.json
data/axes_unb/geocode_cache.json

# payload da API (mesmo dado da camada, fora do diretório público)
data/v5/kv_payload.json

# Cloudflare Worker: dependências e estado local
api/worker/node_modules/
api/worker/.wrangler/
api/worker/.dev.vars

# CNEFE 2022 (IBGE): arquivos por UF, ~1,5 GB, baixados sob demanda por scripts/geocode_cnpj_cnefe.py
data/cnefe/*.zip
data/cnefe/*.part
data/cnefe/progresso.json

# Contribuições: o que é público fica em data/contribuicoes/*.json; nome civil, contato e
# qualquer item marcado como "não publicado" ficam fora do controle de versão, porque o
# repositório é público. Ver POLITICA_DE_CONTRIBUICOES.md.
data/contribuicoes/_privado/
!data/contribuicoes/_privado/.gitkeep
